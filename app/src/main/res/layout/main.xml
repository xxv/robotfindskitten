<?xml version="1.0" encoding="utf-8"?>
<!--
    The system window insets are applied by this outer FrameLayout rather than the RelativeLayout,
    as RelativeLayout ignores its padding when centering the board, which clips the top row when
    the top inset is larger than the bottom one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fitsSystemWindows="true" >

<RelativeLayout
    android:id="@+id/screen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent" >

    <info.staticfree.android.robotfindskitten.RFKView
        android:id="@+id/rfk"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/robot"
            style="@style/EtherItem.Robot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/robot"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/nki"
            style="@style/EtherItem.NKI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/robot"
            android:visibility="invisible" />
    </info.staticfree.android.robotfindskitten.RFKView>

    <TextView
        android:id="@+id/thing_message"
        style="@style/NKIDescription"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:visibility="invisible" />

</RelativeLayout>

</FrameLayout>
